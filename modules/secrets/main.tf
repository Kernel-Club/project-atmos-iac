data "aws_caller_identity" "current" {}

data "aws_region" "current" {}
# Read-only lookups: our AWS account ID and region.
# We need them to write the exact "address" (ARN) of the secrets in the IAM policy.

# ---------------------------------------------------------------------------
# 1. OpenWeather API key (one secret per environment)
# ---------------------------------------------------------------------------

resource "aws_secretsmanager_secret" "openweather" {
  for_each = var.environments

  name                    = "${var.project_name}/${each.key}/openweather-api-key"
  description             = "OpenWeather API key for the ${each.key} environment"
  recovery_window_in_days = 0
}

resource "aws_secretsmanager_secret_version" "openweather" {
  for_each = var.environments

  secret_id     = aws_secretsmanager_secret.openweather[each.key].id
  secret_string = var.openweather_api_key
}
# AWS Secrets Manager is a safe place for passwords and API keys.
# The first block creates the "box" (the secret), the second puts the value inside.
# The value comes from a variable, so it is never written in the code.
# recovery_window_in_days = 0 deletes the secret right away on "terraform destroy".
# Without it AWS keeps the name locked for 7-30 days and the next "apply" would fail.
# Note: Terraform keeps the value in its state file too. That file is in our private,
# encrypted S3 bucket, so this is acceptable for this project.

# ---------------------------------------------------------------------------
# 2. MongoDB password (generated by Terraform, one per environment)
# ---------------------------------------------------------------------------

resource "random_password" "mongodb" {
  for_each = var.environments

  length  = 24
  special = false
}
# Makes a random 24-character password for each environment, so no human has to
# invent or see it. special = false keeps only letters and numbers, because
# special characters often break MongoDB connection URLs.

resource "aws_secretsmanager_secret" "mongodb" {
  for_each = var.environments

  name                    = "${var.project_name}/${each.key}/mongodb"
  description             = "MongoDB credentials for the ${each.key} environment"
  recovery_window_in_days = 0
}

resource "aws_secretsmanager_secret_version" "mongodb" {
  for_each = var.environments

  secret_id = aws_secretsmanager_secret.mongodb[each.key].id
  secret_string = jsonencode({
    username = "atmos"
    password = random_password.mongodb[each.key].result
  })

  lifecycle {
    ignore_changes = [secret_string]
  }
}
# Stores the MongoDB username and password together as JSON.
# ignore_changes: after the first creation Terraform will not touch the value again.
# This matters for credential rotation (new password added in AWS, old one removed
# later): Terraform must not overwrite the rotated value.

# ---------------------------------------------------------------------------
# 3. Access for the cluster (External Secrets Operator)
# ---------------------------------------------------------------------------

resource "aws_iam_role" "external_secrets" {
  name = "${var.project_name}-external-secrets-role"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Effect    = "Allow"
        Principal = { Service = "pods.eks.amazonaws.com" }
        Action    = ["sts:AssumeRole", "sts:TagSession"]
      }
    ]
  })
}
# External Secrets Operator is a small program that runs in the cluster.
# It reads secrets from AWS and creates normal Kubernetes Secrets from them,
# so the application never needs AWS keys. This role is the "badge" it uses.

resource "aws_iam_role_policy" "external_secrets" {
  name = "ReadProjectSecrets"
  role = aws_iam_role.external_secrets.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Effect = "Allow"
        Action = [
          "secretsmanager:GetSecretValue",
          "secretsmanager:DescribeSecret"
        ]
        Resource = "arn:aws:secretsmanager:${data.aws_region.current.region}:${data.aws_caller_identity.current.account_id}:secret:${var.project_name}/*"
      }
    ]
  })
}
# Least privilege: the role can only READ secrets whose name starts with
# "project-atmos/". It cannot change or delete them, and it cannot see other secrets.

resource "aws_eks_pod_identity_association" "external_secrets" {
  cluster_name    = var.cluster_name
  namespace       = "external-secrets"
  service_account = "external-secrets"
  role_arn        = aws_iam_role.external_secrets.arn
}
# Connects the role to the pod: "the service account external-secrets in the
# namespace external-secrets may use this role". The namespace and service account
# names are the defaults of the External Secrets Helm chart.
# Because one role is used by one cluster-wide operator, it can read DEV and PROD
# secrets. Separation between environments is done in the Kubernetes manifests.
